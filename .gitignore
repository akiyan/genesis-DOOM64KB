# ビルド成果物
/out/
/tmp/

# SGDK 本体（symlink / 各環境で用意。詳細は README）
/vendor/sgdk

# 自動生成物（build.sh が scripts/doom64.wad から再生成）
/scripts/doom64_aligned.wad
/scripts/__pycache__/
/src/doom64ng.h
/src/gen_pal.h
/src/gen_sfx.h

# SFX 音源 WAD（リポジトリには含めない。各自 scripts/ に配置。無ければ SFX 無効でビルド）
/scripts/doom1.wad

# rescomp 生成物（res/*.res から再生成。ソースは *.res と *.vgm のみ追跡）
/res/*.h
/res/*.rs
/res/*.d
._*

# エディタ等
*.o
*.lst
*.bin
.DS_Store
